# Is file ko copy karke ".env" naam se save karein aur values bharein.
# ".env" ko KABHI GitHub par upload na karein (.gitignore already block karta hai).

PORT=3000
NODE_ENV=development

# --- AI key (sirf server par rehti hai, browser ko kabhi nahi milti) ---
AI_API_KEY=apni_api_key_yahan
# Optional: AI_PROVIDER=gemini  ya  anthropic (key se auto-detect hota hai)
# Optional: AI_MODEL=gemini-2.5-flash

# --- Login secret: koi bhi lamba random text (50+ characters) ---
JWT_SECRET=koi_bohat_lamba_random_text_yahan_likhein_1234567890abcdefghij

# --- Email alerts (login, signup, hacking attempts) ---
ALERT_EMAIL=uuzairarani3@gmail.com
# Option A: Gmail App Password (local par chalta hai)
SMTP_USER=uuzairarani3@gmail.com
SMTP_PASS=gmail_app_password_16_letters
# Option B: Resend (Render free par SMTP block hota hai, isliye live ke liye ye use karein)
# RESEND_API_KEY=re_xxxxxxxxx

# Database file ki jagah (optional)
# DB_PATH=./data/uzair.db
